# Copy to .env and edit. Everything about YOU lives in candidate/ (gitignored);
# this file only holds machine settings, secrets and a few overrides.

# --- Candidate profile ---
# Directory holding gates.json, rules.md and your base CV. Defaults to ./candidate.
# Start with: cp -r candidate.example candidate
# CANDIDATE_DIR=./candidate

# Base resume (LaTeX, using the \jobtitle / \projecttitle / \skillcat / \edutitle macros
# from candidate.example/resume.tex). A track may point at its own variant through the
# env var named in gates.json tracks.<name>.base_resume_env.
RESUME_TEX_PATH=./candidate/resume.tex
# RESUME_TEX_PATH_PARTTIME=./candidate/resume_parttime.tex

# Header fields: optional overrides for the "header" block in gates.json.
# CANDIDATE_NAME=
# CANDIDATE_LOCATION=
# CANDIDATE_DEGREE=
# CANDIDATE_PHONE=
# CANDIDATE_EMAIL=
# CANDIDATE_LINKEDIN=
# CANDIDATE_GITHUB=
# CANDIDATE_WEBSITE=

# Free-text context for the tailoring prompt: stack, domain, voice. Under 500 chars.
# Do NOT put an availability sentence here; availability comes from gates.json tracks.
CANDIDATE_CONTEXT=

# Placeholders the track availability strings may use ({thesis_submission}). The
# {in_two_months} placeholder is computed from today's date at generation time.
# THESIS_SUBMISSION=Feb 2027

# Filename prefix for generated PDFs (Jane_Example -> Jane_Example_acme_20260417.pdf)
OUTPUT_FILENAME_PREFIX=Tailored_Resume

# --- LLM provider ---
#
# Option A: OpenAI-compatible HTTP endpoint (OpenAI, OpenRouter, z.ai, local Ollama).
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
#
# Option B: Claude Code CLI. Uses your existing OAuth session, no API key.
# Requires `claude` on PATH.
#   LLM_PROVIDER=claude-code
#   LLM_MODEL=haiku            # or: sonnet, opus
#   LLM_API_KEY=unused          # still required by config.py validation
#
# Option C: Antigravity `agy` CLI (Gemini). Requires `agy` on PATH and authenticated.
#   LLM_PROVIDER=gemini         # or: agy
#   AGY_MODEL=                  # blank = default
#   LLM_API_KEY=unused

# --- ATS fit-scoring backend (ats_check.py) ---
#   ATS_FIT_PROVIDER=gemini       # default: agy/Gemini, fall back to Claude
#   ATS_FIT_PROVIDER=gemini-only
#   ATS_FIT_PROVIDER=claude

# GitHub username: your repos are offered to the tailoring step as project candidates.
GITHUB_USERNAME=your-github-username

# LaTeX compiler.
# Windows: C:\Users\YourName\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
# Linux:   /usr/bin/pdflatex
PDFLATEX_PATH=pdflatex

# Optional pre-flight JD gate: a directory containing jd_blocker_check.py that exposes
# check(text, company, track) -> (hard, soft). Unset = no gate.
# JD_GATE_PATH=
